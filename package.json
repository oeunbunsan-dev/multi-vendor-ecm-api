{
  "name": "emc-api",
  "version": "1.0.0",
  "description": "Production-ready Multi-Vendor E-Commerce REST API with ElysiaJS, TypeScript, PostgreSQL, Prisma, Redis, Docker, and Bun",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "elysia": "latest",
    "ioredis": "^6.0.0",
    "prisma": "^6.4.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.4",
    "bun-types": "latest"
  },
  "module": "src/index.ts"
}
