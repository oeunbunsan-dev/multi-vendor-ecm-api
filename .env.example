# Application
PORT=3001
NODE_ENV=development
API_PREFIX=/api
APP_NAME="EMC Multi-Vendor E-Commerce API"
APP_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emc_ecommerce?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# JWT Secrets
JWT_ACCESS_SECRET="super-secret-jwt-access-token-key-32-chars-min-production"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-token-key-32-chars-min-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Super Admin Default Credentials
DEFAULT_ADMIN_EMAIL="admin@emc.com"
DEFAULT_ADMIN_PASSWORD="AdminPassword123!"

# Payment Gateways (Mock / Sandbox)
STRIPE_SECRET_KEY="sk_test_mock_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_stripe_webhook"
PAYPAL_CLIENT_ID="mock_paypal_client_id"
PAYPAL_CLIENT_SECRET="mock_paypal_client_secret"
ABA_PAYWAY_API_KEY="mock_aba_payway_api_key"
ABA_PAYWAY_MERCHANT_ID="mock_aba_merchant_id"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,image/gif"
